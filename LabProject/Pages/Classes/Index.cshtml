@page
@model LabProject.Pages.Classes.IndexModel
@{
    ViewData["Title"] = "Class DB View";
}

<h2>Class Database List</h2>

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <input type="hidden" asp-for="NewClass.Id" />

            <div class="form-group">
                <label>Name</label>
                <input asp-for="NewClass.Name" class="form-control" required />
            </div>
            <div class="form-group">
                <label>Person Count</label>
                <input asp-for="NewClass.PersonCount" class="form-control" required />
            </div>
            <div class="form-group">
                <label>Description</label>
                <textarea asp-for="NewClass.Description" class="form-control"></textarea>
            </div>
            <div class="form-group">
                <label>Is Active</label>
                <input asp-for="NewClass.IsActive" type="checkbox" />
            </div>

            @if (Model.IsEditing)
            {
                <button type="submit" asp-page-handler="Update" class="btn btn-warning">Update</button>
            }
            else
            {
                <button type="submit" asp-page-handler="Add" class="btn btn-primary">Add</button>
            }
        </form>
    </div>

    <div class="col-md-8">
        <form method="get" class="mb-2">
            <input name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by name..." />
        </form>

        <form method="post" asp-page-handler="ExportJson">
            <button type="submit" class="btn btn-success mb-2">Export JSON</button>
        </form>

        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Count</th>
                    <th>Description</th>
                    <th>Active</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.ClassList)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.PersonCount</td>
                    <td>@item.Description</td>
                    <td>@(item.IsActive ? "Yes" : "No")</td>
                    <td>
                        <a asp-page-handler="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>

        <nav>
            <ul class="pagination">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-route-SearchTerm="@Model.SearchTerm" asp-route-PageNumber="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>