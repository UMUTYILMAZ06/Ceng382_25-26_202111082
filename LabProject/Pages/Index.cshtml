@page
@model LabProject.Pages.IndexModel
@{
    ViewData["Title"] = "Class Information";
}

<div class="container mt-5">
    <div class="row">
        <!-- Form for Class Information -->
        <div class="col-md-4">
            <h2>@(Model.IsEditing ? "Edit" : "Add") Class Information</h2>

            <!-- Display IsEditing value -->
            <p><strong>IsEditing Value: </strong>@Model.IsEditing</p>

            <form method="post">
                <input type="hidden" asp-for="NewClass.Id" />
                <div class="form-group">
                    <label for="ClassName">Class Name</label>
                    <input type="text" class="form-control" asp-for="NewClass.ClassName" required />
                </div>
                <div class="form-group">
                    <label for="StudentCount">Student Count</label>
                    <input type="number" class="form-control" asp-for="NewClass.StudentCount" required />
                </div>
                <div class="form-group">
                    <label for="Description">Description</label>
                    <textarea class="form-control" asp-for="NewClass.Description"></textarea>
                </div>
                @if (Model.IsEditing)
                {
                    <button type="submit" asp-page-handler="Update" class="btn btn-warning mt-3">Update</button>
                }
                else
                {
                    <button type="submit" asp-page-handler="Add" class="btn btn-primary mt-3">Save Class</button>
                }
            </form>
        </div>

        <!-- Table and Export Section -->
        <div class="col-md-8">
            <h2>Class List</h2>

            <!-- Filter Form -->
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by class name..." />
                    <button type="submit" class="btn btn-secondary">Filter</button>
                </div>
            </form>

            <!-- Export Form -->
            <form method="post" asp-page-handler="ExportJson" class="mb-3">
                <div class="form-group">
                    <label>Select Columns to Export:</label><br />
                    <label class="me-2"><input type="checkbox" name="SelectedColumns" value="ClassName" /> Class Name</label>
                    <label class="me-2"><input type="checkbox" name="SelectedColumns" value="StudentCount" /> Student Count</label>
                    <label class="me-2"><input type="checkbox" name="SelectedColumns" value="Description" /> Description</label>
                </div>
                <div class="form-group mt-2">
                    <label>Export Mode:</label><br />
                    <label class="me-2"><input type="radio" name="ExportMode" value="All" checked /> Unfiltered Export</label>
                    <label class="me-2"><input type="radio" name="ExportMode" value="Filtered" /> Filtered Export</label>
                </div>
                <button type="submit" class="btn btn-success mt-2">Export to JSON</button>
            </form>

            <!-- Data Table -->
            <table class="table table-bordered table-striped table-hover">
                <thead>
                    <tr>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PaginatedData.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center">No data found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.PaginatedData)
                        {
                            <tr>
                                <td>@item.ClassName</td>
                                <td>@item.StudentCount</td>
                                <td>@item.Description</td>
                                <td>
                                    <a asp-page-handler="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                                    <a asp-page-handler="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <!-- Pagination Controls -->
            <nav>
                <ul class="pagination">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-page="./Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-PageNumber="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>
