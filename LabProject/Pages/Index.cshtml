@page
@model LabProject.Pages.IndexModel
@{
    ViewData["Title"] = "Class Information";
}

<div class="container mt-5">
    <div class="row">
        <!-- Form -->
        <div class="col-md-4">
            <h2>@(Model.IsEditing ? "Edit" : "Add") Class Information</h2>
            <form method="post">
                <input type="hidden" asp-for="NewClass.Id" />
                <div class="form-group">
                    <label>Class Name</label>
                    <input type="text" class="form-control" asp-for="NewClass.ClassName" required />
                </div>
                <div class="form-group">
                    <label>Student Count</label>
                    <input type="number" class="form-control" asp-for="NewClass.StudentCount" required />
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <textarea class="form-control" asp-for="NewClass.Description"></textarea>
                </div>
                @if (Model.IsEditing)
                {
                    <button type="submit" asp-page-handler="Update" class="btn btn-warning mt-3">Update</button>
                }
                else
                {
                    <button type="submit" asp-page-handler="Add" class="btn btn-primary mt-3">Save Class</button>
                }
            </form>
        </div>

        <!-- Table & Export -->
        <div class="col-md-8">
            <h2>Class List</h2>

            <!-- Filter -->
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by class name..." />
                    <button type="submit" class="btn btn-secondary">Filter</button>
                </div>
            </form>

            <!-- Export Form -->
            <form method="post" asp-page-handler="ExportJson" class="mb-3">
                <input type="hidden" id="SelectedColumnsInput" name="SelectedColumns" />
                <button type="submit" class="btn btn-success mt-2">Export</button>
            </form>

            <!-- Table -->
            <table class="table table-bordered table-striped table-hover" id="classTable">
                <thead>
                    <tr>
                        <th class="selectable-column" data-column="ClassName">Class Name</th>
                        <th class="selectable-column" data-column="StudentCount">Student Count</th>
                        <th class="selectable-column" data-column="Description">Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PaginatedData)
                    {
                        <tr>
                            <td class="col-ClassName">@item.ClassName</td>
                            <td class="col-StudentCount">@item.StudentCount</td>
                            <td class="col-Description">@item.Description</td>
                            <td>
                                <a asp-page-handler="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                                <a asp-page-handler="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            <nav>
                <ul class="pagination">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-page="./Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-PageNumber="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/column-select.js"></script>
}
